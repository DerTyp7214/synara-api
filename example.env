# --- Covers ---
# Seconds to wait after the last content change before regenerating a cover.
COVER_AUTO_DEBOUNCE_SECONDS=30
# Whether covers are generated automatically for playlists and collections without one.
COVER_AUTO_GENERATE=true
# Whether NSFW cover asset packs may be used when a request opts in.
COVER_NSFW_PACKS_ENABLED=false

# --- Credential Server ---
# Admin key of the credential server. The credential server requires it as X-Admin-Key for its admin routes and answers 503 while it is unset. A Synara server uses the same variable to manage a connected credential server.
CREDENTIAL_SERVER_ADMIN_KEY=
# Client id this Synara server uses to authenticate at the credential server.
CREDENTIAL_SERVER_CLIENT_ID=
# Client secret belonging to CREDENTIAL_SERVER_CLIENT_ID.
CREDENTIAL_SERVER_CLIENT_SECRET=
# JDBC driver of the credential server database. Use org.postgresql.Driver for PostgreSQL.
CREDENTIAL_SERVER_DB_DRIVER=org.sqlite.JDBC
# Database password of the credential server (PostgreSQL only).
CREDENTIAL_SERVER_DB_PASSWORD=
# JDBC URL of the credential server database.
CREDENTIAL_SERVER_DB_URL="jdbc:sqlite:credentials.db"
# Database user of the credential server (PostgreSQL only).
CREDENTIAL_SERVER_DB_USER=
# Issuer claim of the tokens signed by the credential server.
CREDENTIAL_SERVER_ISSUER=synara-credentials
# Path of the generated master key file, used when no master key is set.
CREDENTIAL_SERVER_KEY_FILE=master.key
# Master key that encrypts the stored credentials and signing keys of the credential server. When empty, a key file is generated instead.
CREDENTIAL_SERVER_MASTER_KEY=
# HTTP port of the credential server.
CREDENTIAL_SERVER_PORT=8083
# Lifetime of the access tokens issued by the credential server in seconds.
CREDENTIAL_SERVER_TOKEN_TTL_SECONDS=900
# Base URL of a credential server this Synara server fetches third-party credentials from. Can also be set on the credential server settings page.
CREDENTIAL_SERVER_URL=

# --- Database Configuration ---
# Directory for database backups.
BACKUP_DIR=
# JDBC driver class name.
DB_DRIVER=org.sqlite.JDBC
# Database password.
DB_PASSWORD=
# JDBC connection URL.
DB_URL="jdbc:sqlite:data.db"
# Database username.
DB_USER=
# Path to a backup file to initialize the server from (only if the database is empty).
SETUP_FROM_BACKUP=
# Password for the remote server mirroring setup.
SETUP_FROM_MIRROR_PASSWORD=
# URL of another Synara server to initialize from (only if the database is empty).
SETUP_FROM_MIRROR_URL=
# Username for the remote server mirroring setup.
SETUP_FROM_MIRROR_USERNAME=

# --- External Services ---
# An AcoustID client API key used to identify songs without a MusicBrainz id by audio fingerprint. The Docker images set a default Synara key. Without a key, fingerprint matching is skipped. Overridable in the admin settings.
ACOUSTID_API_KEY=
# Apple Music Key ID.
APPLE_MUSIC_KEY_ID=
# Path to the Apple Music .p8 private key file.
APPLE_MUSIC_P8_PATH=
# Apple Music storefront (country code) used for catalog requests.
APPLE_MUSIC_STOREFRONT=us
# Apple Music Team ID.
APPLE_MUSIC_TEAM_ID=
# Optional gamdl song codec override (empty = gamdl default, e.g. aac-web). Advanced/version-sensitive.
GAMDL_CODEC_SONG=
# Path to the Netscape cookies.txt for Apple Music (gamdl importer).
GAMDL_COOKIES_PATH=cookies.txt
# Optional path to a Widevine .wvd device for higher-quality gamdl codecs.
GAMDL_WVD_PATH=
# Image Cache auth token.
IMAGE_CACHE_TOKEN=
# Image Cache service URL.
IMAGE_CACHE_URL=
# API key for the self-hosted LinkResolver service (linkresolver.synara.audio).
LINKRESOLVER_API_KEY=
# Podcast Index (podcastindex.org) API key used to search podcast directories. Can also be stored through the admin settings card, which takes precedence.
PODCAST_INDEX_API_KEY=
# Podcast Index API secret belonging to PODCAST_INDEX_API_KEY.
PODCAST_INDEX_API_SECRET=
# Spotify API Client ID.
SPOTIFY_CLIENT_ID=
# Spotify API Client Secret.
SPOTIFY_CLIENT_SECRET=
# Tidal API Client ID.
TIDAL_CLIENT_ID=
# Tidal API Client Secret.
TIDAL_CLIENT_SECRET=
# Optional Tidal client for tiddl in the form client_id;client_secret, the same value tiddl reads. When set, the credential server page sends it for tiddl sessions whenever the client id and secret fields are blank.
TIDDL_AUTH=
# Transcriber service URL.
TRANSCRIBER_URL="http://localhost:8000"

# --- General & Authentication ---
# Initial admin username (only on first run).
CLIENT_ID=
# Initial admin password (only on first run).
CLIENT_SECRET=
# Key that encrypts credentials stored through the admin settings, for example the Podcast Index and AcoustID keys. Generate one with `openssl rand -base64 32`. When unset, a random key is generated once into CREDENTIALS_KEY_FILE. Keep this value, or the key file, to read stored credentials after restoring a backup on another host.
CREDENTIALS_ENCRYPTION_KEY=
# Key file used when CREDENTIALS_ENCRYPTION_KEY is unset. Defaults to `~/.config/synara/credentials.key` and is created on first start.
CREDENTIALS_KEY_FILE=
# The audience claim for JWT tokens.
JWT_AUDIENCE=synara-api
# The issuer claim for JWT tokens.
JWT_ISSUER=synara
# The realm for JWT authentication.
JWT_REALM="Access to 'Synara-API'"
# Secret key for signing tokens.
JWT_SECRET=changeme
# The port the server listens on.
PORT=8080

# --- Metrics ---
# Whether to collect RPC call usage metrics (invocation counts per call, per user, over time).
METRICS_ENABLED=true
# How long (in hours) individual call events are retained in the capped event log before pruning. Lifetime totals are never pruned.
METRICS_EVENT_LOG_RETENTION_HOURS=24
# How often (in seconds) buffered in-memory call counts are flushed to the database.
METRICS_FLUSH_INTERVAL_SECONDS=60

# --- Other ---
# How long (in days) recorded library changes are kept for clients that ask what changed since their last pull. A client that was away longer reads everything again.
ENTITY_CHANGE_RETENTION_DAYS=30
SERVER_SSL_SUPPORTED=false
# Multiplier for background worker threads. Scales the number of parallel tasks relative to CPU cores.
WORKER_THREAD_MULTIPLIER=1.0
# Youtube API key for YouTube Data API v3 (Downloader).
YOUTUBE_API_KEY=

# --- Proxy Configuration ---
# Port for the proxy control interface.
PROXY_CONTROL_PORT=8081
# Public hostname of the proxy.
PROXY_HOSTNAME=
# Unique identifier for this proxy.
PROXY_ID=
# Authentication key for the proxy.
PROXY_KEY=
# Display name for this proxy instance.
PROXY_NAME=
# Whether to use SSL (true/false).
PROXY_SSL=false

# --- Recommendations ---
# URL of the audio embedding service (MusiCNN). Empty disables per-song audio embeddings.
AUDIO_EMBED_URL=
# Shared directory used to exchange training data with the recommendation (recsys) service. Empty disables recommendation training.
RECSYS_DATA_DIR=

# --- Redis Configuration ---
# Whether to cache animated cover bytes in Redis.
REDIS_CACHE_ANIMATED_IMAGES=false
# Redis server hostname.
REDIS_HOST=
# Prefix for Redis Search indices.
REDIS_INDEX_PREFIX=synara
# Redis server port.
REDIS_PORT=
# Whether to use RediSearch for ranked searching.
REDIS_USE_SEARCH=false

# --- Storage & Paths ---
# Base path for albums.
AUDIO_ALBUMS_PATH=music/albums
# Bitrates for auto-transcoding (Opus).
AUDIO_AUTO_TRANSCODE_QUALITIES=
# Bitrates for auto-transcoding (AAC).
AUDIO_AUTO_TRANSCODE_QUALITIES_AAC=
# Path for custom uploaded audio.
AUDIO_CUSTOM_PATH=music/custom
# Lossless container for audio the server produces (custom uploads, downloader imports): FLAC, WAV or AIFF.
AUDIO_LOSSLESS_FORMAT=FLAC
# Base path for playlists.
AUDIO_PLAYLISTS_PATH=music/playlists
# Base path for audio tracks.
AUDIO_TRACKS_PATH=music/tracks
# Optional secondary audio path.
AUDIO_TRACKS_SECONDARY_PATH=
# Path for transcoded files.
AUDIO_TRANSCODE_PATH=music/transcode
# Path for cached animated covers.
DATA_ANIMATED_IMAGES_PATH=data/animated-images
# Path containing cover asset packs (one directory with pack.json per pack).
DATA_COVER_ASSETS_PATH=data/cover-assets
# Path for cached images/covers.
DATA_IMAGES_PATH=data/images
# Folder where episodes of IMPORT-mode feed subscriptions are stored (<showId>/<episodeId>.<ext>).
PODCASTS_IMPORTS_PATH=podcasts/imports
# Root folder of local podcast shows: one sub-folder per show, audio files inside become episodes.
PODCASTS_LIBRARY_PATH=podcasts/library
# Path to yt-dlp.conf for yt-dlp.
YTDLP_CONFIG_PATH=
