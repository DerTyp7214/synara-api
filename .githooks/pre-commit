#!/bin/bash

# Paths whose changes feed the generated documentation
PATHS_TO_CHECK=(
    "common-rpc/"
    "server/src/main/"
    "plugin-api/src/main/"
    "proxy/src/main/resources/application.yaml"
    "Dockerfile.nobuild"
    "build.gradle.kts"
    "server/build.gradle.kts"
)

STAGED_FILES=$(git diff --cached --name-only)
NEEDS_REBUILD=false

for path in "${PATHS_TO_CHECK[@]}"; do
    if echo "$STAGED_FILES" | grep -q "^$path"; then
        NEEDS_REBUILD=true
        break
    fi
done

# The submodule common-rpc itself may be staged as a pointer change
if echo "$STAGED_FILES" | grep -q "^common-rpc$"; then
    NEEDS_REBUILD=true
fi

if [ "$NEEDS_REBUILD" = true ]; then
    echo "Changes detected in generated documentation sources. Rebuilding documentation..."

    ./gradlew generateDocs

    if [ $? -eq 0 ]; then
        git add docs/RPC_SERVICES.md docs/MODELS.md docs/REST_API.md docs/PERMISSIONS.md docs/API_CONSTANTS.md docs/ENVIRONMENT_VARIABLES.md example.env
        echo "Documentation rebuilt and staged."
    else
        echo "Documentation build failed. Please check for errors."
        exit 1
    fi
fi

exit 0
