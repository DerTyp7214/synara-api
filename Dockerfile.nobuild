FROM python:3.13-slim-bookworm AS python-base
FROM mwader/static-ffmpeg:8.1.1 AS ffmpeg-builder
FROM mtgupf/essentia:latest AS essentia-source

FROM mtgupf/essentia:latest AS essentia-libs
RUN mkdir -p /libs && \
    ldd /usr/local/bin/essentia_streaming_extractor_music | grep "=> /" | awk '{print $3}' | \
    grep -vE 'libc\.so|libm\.so|libpthread\.so|libdl\.so|librt\.so|libgcc_s\.so|libstdc\+\+\.so|libselinux\.so|libresolv\.so|libz\.so|libbz2\.so|liblzma\.so|libexpat\.so|libuuid\.so' | \
    xargs -I '{}' cp -L '{}' /libs/

FROM eclipse-temurin:25-jre AS runtime

ARG APP_USER_ID=1000
ARG APP_GROUP_ID=1000

ARG MONTH_YEAR=unknown

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libstdc++6 \
    zlib1g \
    libc6 \
    libva-drm2 \
    libva2 \
    libdrm2 \
    nano \
    libssl3 \
    libsqlite3-0 \
    libexpat1 \
    libbz2-1.0 \
    liblzma5 \
    libffi8 \
    libuuid1 \
    libreadline8 \
    libncursesw6 \
    flac \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=python-base /usr/local /usr/local

RUN ln -sf /usr/local/bin/python3 /usr/bin/python3 && \
    ln -sf /usr/local/bin/python3 /usr/bin/python && \
    ldconfig

COPY --from=ffmpeg-builder /ffmpeg /usr/bin/
COPY --from=ffmpeg-builder /ffprobe /usr/bin/

COPY --from=denoland/deno:bin /deno /usr/local/bin/deno

COPY --from=essentia-source /usr/local/bin/essentia_streaming_extractor_music /usr/bin/
COPY --from=essentia-source /usr/local/lib/libessentia.so /usr/lib/
COPY --from=essentia-libs /libs/* /usr/lib/essentia/

ENV LD_LIBRARY_PATH="/usr/lib:/usr/local/lib:/usr/lib/essentia:${LD_LIBRARY_PATH:-}"

RUN touch /var/mail/ubuntu && chown ubuntu /var/mail/ubuntu && userdel -r ubuntu
RUN groupadd -g $APP_GROUP_ID appgroup && useradd -u $APP_USER_ID -g appgroup -s /bin/bash -m -d /home/appuser appuser

EXPOSE 8080

RUN mkdir /app && chown appuser:appgroup /app

RUN mkdir /data && chown appuser:appgroup /data

RUN mkdir /backups && chown appuser:appgroup /backups

RUN mkdir -p /home/appuser/.tiddl
RUN mkdir -p /home/appuser/.config/tidal_dl_ng
RUN chown -R appuser:appgroup /home/appuser

ARG DAY_MONTH_YEAR=unknown

RUN python3 -m pip install --break-system-packages --no-cache-dir syncedlyrics yt-dlp tiddl && \
    sed -i 's/facebookUid: int/facebookUid: Optional[int] = None/' /usr/local/lib/python3.*/site-packages/tiddl/core/auth/models.py && \
    find /usr/local/lib/python3.*/site-packages/tiddl -name "__pycache__" -type d -exec rm -rf {} +

COPY --chown=appuser:appuser docker/tiddl/config.toml /home/appuser/.tiddl/config.toml
COPY --chown=appuser:appuser docker/tdn-config/settings.json /home/appuser/.config/tidal_dl_ng/settings.json
COPY --chown=appuser:appgroup *.jar /app/synara-api.jar

USER appuser

ENV AUDIO_TRACKS_PATH="/data/Synara/Tracks"
ENV AUDIO_ALBUMS_PATH="/data/Synara/Albums"
ENV AUDIO_PLAYLISTS_PATH="/data/Synara/Playlists"
ENV AUDIO_TRANSCODE_PATH="/data/Synara/Transcode"
ENV AUDIO_CUSTOM_PATH="/data/Synara/custom"
ENV DATA_IMAGES_PATH="/data/Synara/Images"
ENV BACKUP_DIR="/backups"

ENV AUDIO_TRACKS_SECONDARY_PATH="/data/Synara/other"

ENV HOME=/home/appuser
ENTRYPOINT ["java","--enable-native-access=ALL-UNNAMED","-jar","/app/synara-api.jar"]